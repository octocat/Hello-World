Maven HelloWorld Project – Short Explanation
A Maven HelloWorld project is a simple Java application created using Maven to understand project structure, compilation and execution.
1. Create Maven Project
In VS Code / terminal, create a Maven project using:
mvn archetype:generate -DgroupId=com.example -DartifactId=HelloWorld -DarchetypeArtifactId=maven-archetype-quickstart -DinteractiveMode=false


Move into the project:
cd HelloWorld










FROM tomcat:9-jdk11

# Copy the built WAR file to Tomcat webapps directory
COPY target/*.war /usr/local/tomcat/webapps/

# Expose the Tomcat port
EXPOSE 8080

# Start Tomcat server
CMD ["catalina.sh", "run"]


docker-compose.yml


services:
  db:
    image: mysql:8.0
    container_name: mysql-db
    restart: always
    environment:
      MYSQL_ROOT_PASSWORD: root123
      MYSQL_DATABASE: wordpress
      MYSQL_USER: user
      MYSQL_PASSWORD: pass123
    volumes:
      - db_data:/var/lib/mysql
    networks:
      - mynetwork

  wordpress:
    image: wordpress:latest
    container_name: wordpress-app
    restart: always
    ports:
      - "8080:80"
    environment:
      WORDPRESS_DB_HOST: db:3306
      WORDPRESS_DB_USER: user
      WORDPRESS_DB_PASSWORD: pass123
      WORDPRESS_DB_NAME: wordpress
    depends_on:
      - db
    networks:
      - mynetwork

volumes:
  db_data:

networks:
  mynetwork:

